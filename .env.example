# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Vector Store Configuration
VECTOR_STORE_PROVIDER=chroma  # 'chroma' or 'pinecone'
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=multimodal-doc-intelligence

# Embeddings Strategy
EMBEDDING_PROVIDER=huggingface  # 'huggingface' or 'openai'
HF_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# LangSmith Observability
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=multimodal-document-intelligence

# Safety & Guardrails
ENABLE_PII_MASKING=true
ENABLE_PROMPT_INJECTION_SCANNER=true
CONFIDENCE_THRESHOLD=0.65

# App Configuration
STREAMLIT_SERVER_PORT=8501
